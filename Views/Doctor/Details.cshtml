@model Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<h2>Doctor Details</h2>
<p class="text-muted">Page generated at: @DateTime.Now.ToString("HH:mm:ss")</p>

<table class="table table-bordered w-50">
    <tr><th>ID</th><td>@Model.DoctorId</td></tr>
    <tr><th>Name</th><td>@Model.DoctorName</td></tr>
    <tr><th>Specialization</th><td>@Model.Specialization</td></tr>
    <tr><th>Experience</th><td>@Model.Experience years</td></tr>
    <tr><th>Consultation Fee</th><td>₹@Model.ConsultationFee</td></tr>
    <tr><th>Total Charge</th><td>₹@Model.CalculateTotalCharge()</td></tr>
</table>

<h4>Book Appointment</h4>

<form asp-action="BookAppointment" method="post" class="w-50" asp-antiforgery="false">
    <input type="hidden" name="doctorId" value="@Model.DoctorId" />

    <div class="mb-3">
        <label class="form-label">Patient Name</label>
        <input type="text" name="patientName" class="form-control" value="@ViewBag.PatientName" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Appointment Date</label>
        <input type="date" name="appointmentDate" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Book Appointment</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>